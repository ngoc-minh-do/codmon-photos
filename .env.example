# Copy to .env and fill in. Never commit .env.

CODMON_EMAIL=your-codmon-email@example.com
CODMON_PASSWORD=your-codmon-password

# Standard TZ variable: IANA timezone used for "today" when scanning for the
# latest album (default Asia/Tokyo when unset).
TZ=Asia/Tokyo

# Optional Apprise webhook; posts a success notification after an upload that
# actually put new photos on the share (all-skip runs stay silent).
#APPRISE_URL=https://apprise.example.example/notify/codmon-photos

# Optional: NAS SMB share that receives the photos matching a person (see
# scripts/face_filter.py upload). Albums always stay local; only
# matched/<name>/ is mirrored to //<host>/<share>/<name>/<album>/. Set all four
# or leave all unset.
#SMB_HOST=nas.example.com
#SMB_SHARE=photos
#SMB_USER=your-nas-user
#SMB_PASSWORD=your-nas-password